<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="arm_ros2_control" params="name initial_positions_file use_mock_hardware:=false hardware_plugin:=dynamixel_node/DynamixelServos mock_servo_ids:=''">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_mock_hardware}">
                  <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:unless value="${use_mock_hardware}">
                  <plugin>${hardware_plugin}</plugin>
                  <param name="device">/dev/ttyUSB0</param>
                  <param name="baud_rate">1000000</param>
                  <param name="mock_servo_ids">${mock_servo_ids}</param>
                </xacro:unless>
            </hardware>

            <joint name="shoulder_tilt">
                <param name="servo_id">2</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['shoulder_tilt']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="shoulder_pan">
                <param name="servo_id">1</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['shoulder_pan']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="elbow">
                <param name="servo_id">3</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['elbow']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="wrist_pitch">
                <param name="servo_id">4</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['wrist_pitch']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="wrist_roll">
                <param name="servo_id">5</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['wrist_roll']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <!-- TODO: prismatic joint in metres driven by a rotary servo; needs a conversion. -->
            <!-- right_finger_joint is a URDF mimic; ros2_control mirrors it. -->
            <joint name="left_finger_joint">
                <param name="servo_id">6</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_finger_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

            <!-- Gearbox reductions. The hardware plugin must apply these; ros2_control only parses them. -->
            <transmission name="shoulder_pan_drive">
                <plugin>transmission_interface/SimpleTransmission</plugin>
                <joint name="shoulder_pan" role="joint1">
                    <mechanical_reduction>1.0</mechanical_reduction>
                    <offset>0.0</offset>
                </joint>
                <actuator name="shoulder_pan_servo" role="actuator1">
                    <mechanical_reduction>1.0</mechanical_reduction>
                </actuator>
            </transmission>

            <transmission name="shoulder_tilt_drive">
                <plugin>transmission_interface/SimpleTransmission</plugin>
                <joint name="shoulder_tilt" role="joint1">
                    <mechanical_reduction>1.0</mechanical_reduction>
                    <offset>0.0</offset>
                </joint>
                <actuator name="shoulder_tilt_servo" role="actuator1">
                    <mechanical_reduction>1.0</mechanical_reduction>
                </actuator>
            </transmission>

            <transmission name="elbow_drive">
                <plugin>transmission_interface/SimpleTransmission</plugin>
                <joint name="elbow" role="joint1">
                    <mechanical_reduction>1.0</mechanical_reduction>
                    <offset>0.0</offset>
                </joint>
                <actuator name="elbow_servo" role="actuator1">
                    <mechanical_reduction>1.0</mechanical_reduction>
                </actuator>
            </transmission>

            <!-- Servos 4 and 5 jointly drive pitch and roll. -->
            <transmission name="wrist_differential">
                <plugin>transmission_interface/DifferentialTransmission</plugin>
                <joint name="wrist_pitch" role="joint1">
                    <mechanical_reduction>1.0</mechanical_reduction>
                    <offset>0.0</offset>
                </joint>
                <joint name="wrist_roll" role="joint2">
                    <mechanical_reduction>1.0</mechanical_reduction>
                    <offset>0.0</offset>
                </joint>
                <actuator name="wrist_servo_a" role="actuator1">
                    <mechanical_reduction>1.0</mechanical_reduction>
                </actuator>
                <actuator name="wrist_servo_b" role="actuator2">
                    <mechanical_reduction>1.0</mechanical_reduction>
                </actuator>
            </transmission>
        </ros2_control>
    </xacro:macro>
</robot>
