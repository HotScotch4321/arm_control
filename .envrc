# Machine-local ROS/MoveIt runtime additions.

watch_file .moveit-shell.nix
watch_file flake.nix
use nix ./.moveit-shell.nix --option max-jobs 1 --option cores 2

if [[ -f install/setup.bash ]]; then
  watch_file install/setup.bash
  source install/setup.bash
fi

# Keep standalone tools on the same DDS implementation as servo_sim.launch.py.
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

#
# ros2 launch arm_moveit_config servo_sim.launch.py    # sim
# ros2 run arm_moveit_config keyboard_control    #

# colcon build